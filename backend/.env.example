# AUTOMATIZA AI — Environment Variables
# Copy to .env and fill in your values

# --- App ---
ENVIRONMENT=development

# --- Database (Supabase free tier) ---
# Format: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/automatiza

# --- Redis (Upstash free tier) ---
# Format: rediss://default:[PASSWORD]@[HOST].upstash.io:6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- OpenAI ---
OPENAI_API_KEY=your-api-key-here
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-2

# --- Cloudflare R2 (free tier — 10GB storage, free egress) ---
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=automatiza-ai
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your-hash.r2.dev

# --- CDP Automation ---
CDP_HEADLESS=true

# --- Security ---
SECRET_KEY=generate-a-secure-random-string-here
